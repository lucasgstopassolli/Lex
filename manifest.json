{
    "name": "Nexus",
    "description": "Uma ferramenta simples que ajuda em tarefas diárias do Wordpress",
    "version": "3.9.0",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "downloads",
        "browsingData"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "icons": {
    "16": "/img/16.png",
    "32": "/img/32.png",
    "48": "/img/48.png",
    "128": "/img/128.png"
    },
    "action": {
    "default_popup": "index.html"
    }
  }