{
    "name": "Lex",
    "description": "Uma ferramenta simples e poderosa para tarefas diárias em Wordpress e Design",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "downloads",
        "cookies",
        "clipboardWrite"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "img/16.png",
        "32": "img/32.png",
        "48": "img/48.png",
        "128": "img/128.png"
    },
    "action": {
        "default_icon": {
            "16": "img/16.png",
            "32": "img/32.png",
            "48": "img/48.png",
            "128": "img/128.png"
        },
        "default_popup": "index.html",
        "default_title": "Lex"
    },
    "web_accessible_resources": [
        {
            "matches": [
                "<all_urls>"
            ],
            "resources": [
                "/img/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*/wp-admin/*",
                "*://*/*/wp-admin/*"
            ],
            "css": [
                "css/export.css"
            ]
        },
        {
            "matches": [
                "*://*/wp-admin/edit.php*",
                "*://*/*/wp-admin/edit.php*"
            ],
            "js": [
                "js/utils/create-element.js",
                "js/content-scripts/wp-admin.js"
            ]
        },
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "js/content-scripts/design-mode.js"
            ]
        }
    ],
    "commands": {
        "open-popup": {
            "suggested_key": {
                "default": "Ctrl+Shift+2"
            },
            "description": "Open Lex popup"
        }
    },
    "background": {
        "service_worker": "/js/background.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}