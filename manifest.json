{
    "name": "Nexus",
    "description": "Uma ferramenta simples que ajuda em tarefas diárias do Wordpress",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "downloads",
        "browsingData",
        "background",
        "alarms",
        "cookies",
        "search"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
    "16": "img/16.png",
    "32": "img/32.png",
    "48": "img/48.png",
    "128": "img/128.png"
    },
    "action":{
        "default_icon": {
            "16": "img/16.png",
            "32": "img/32.png",
            "48": "img/48.png",
            "128": "img/128.png"
        },
        "default_popup": "index.html",
        "default_title": "Nexus"
    },
    "content_scripts": [
        {
            "matches": ["*://*/wp-admin/*"],
            "js": [
                "js/redirection.js"
            ],
            "css": [
                "css/pluginSearch.css"
            ]
        }
    ],
    "commands": {
        "open-popup": {
            "suggested_key": {
                "default": "Ctrl+Shift+2"
            },
            "description": "Open Nexus popup"
        }
    },
    "background": {
        "service_worker": "/js/background.js",
        "type": "module"
    },
    "web_accessible_resources": [{
        "matches": ["<all_urls>"],
        "resources": [
            "img/*"
        ]
    }],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' 'unsafe-inline';"
    }
  }